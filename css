
/* General Styling */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #121212;
    color: white;
}

/* Sidebar */
.sidebar {
    width: 230px;
    height: 100vh;
    background: #080808;
    position: fixed;
    padding: 25px 20px;
}

.logo {
    color: #1ed760;
    margin-bottom: 40px;
}

.sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
}

.sidebar nav a {
    text-decoration: none;
    color: #b3b3b3;
    font-size: 16px;
    transition: 0.3s;
}

.sidebar nav a:hover,
.sidebar nav .active {
    color: #1ed760;
}

.sidebar h3 {
    margin-bottom: 20px;
    color: #fff;
}

/* Main Content */
.main-content {
    margin-left: 230px;
    padding: 30px;
    padding-bottom: 160px;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 35px;
}

header h1 {
    font-size: 30px;
    margin-bottom: 10px;
}

header p {
    color: #aaa;
}

.profile {
    background: #282828;
    padding: 12px 20px;
    border-radius: 25px;
}

/* Sections */
section {
    margin-bottom: 40px;
}

section h2 {
    margin-bottom: 20px;
    font-size: 23px;
}

/* Featured Playlist */
.featured {
    height: 220px;
    border-radius: 15px;
    padding: 35px;
    display: flex;
    align-items: center;
    background: linear-gradient(120deg, #542b68, #1ed760);
}

.featured h1 {
    font-size: 35px;
    margin-bottom: 10px;
}

.featured p {
    margin-bottom: 20px;
}

button {
    border: none;
    cursor: pointer;
    font-weight: bold;
}

.featured button {
    background: white;
    color: black;
    padding: 12px 25px;
    border-radius: 25px;
}

/* Artists */
.artist-container {
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
}

.artist {
    text-align: center;
    width: 130px;
}

.artist img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 12px;
}

.artist h3 {
    font-size: 15px;
}

/* Music Cards */
.music-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.music-card {
    background: #202020;
    padding: 15px;
    border-radius: 12px;
    transition: 0.3s;
}

.music-card:hover {
    background: #303030;
    transform: translateY(-5px);
}

.music-card img {
    width: 100%;
    border-radius: 10px;
    margin-bottom: 12px;
}

.music-card h3 {
    font-size: 16px;
    margin-bottom: 7px;
}

.music-card p {
    color: #aaa;
    font-size: 14px;
    margin-bottom: 12px;
}

.music-card button {
    background: #1ed760;
    padding: 9px 20px;
    border-radius: 20px;
    color: black;
}

/* Recently Played */
.song-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.song {
    display: flex;
    align-items: center;
    gap: 15px;
    background: #202020;
    padding: 10px;
    border-radius: 10px;
}

.song img {
    width: 55px;
    height: 55px;
    border-radius: 8px;
}

.song h4 {
    margin-bottom: 5px;
}

.song p {
    color: #aaa;
    font-size: 13px;
}

.song span {
    margin-left: auto;
    color: #aaa;
}

/* Music Player */
.player {
    position: fixed;
    bottom: 0;
    left: 230px;
    right: 0;
    background: #181818;
    border-top: 1px solid #333;
    padding: 15px 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

.current-song {
    display: flex;
    align-items: center;
    gap: 12px;
}

.current-song img {
    width: 60px;
    border-radius: 8px;
}

.current-song p {
    color: #aaa;
    font-size: 13px;
    margin-top: 5px;
}

.controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
}

.buttons {
    display: flex;
    align-items: center;
    gap: 25px;
}

.buttons button {
    color: white;
    background: transparent;
    font-size: 20px;
}

.buttons .play-button {
    background: #1ed760;
    color: black;
    padding: 10px 13px;
    border-radius: 50%;
}

.controls audio {
    width: 250px;
    height: 30px;
}

.volume {
    color: #aaa;
}

/* Responsive Design */
@media (max-width: 900px) {
    .music-container {
        grid-template-columns: repeat(2, 1fr);
    }

    .artist-container {
        gap: 20px;
    }
}

@media (max-width: 600px) {
    .sidebar {
        width: 65px;
        padding: 20px 10px;
    }

    .sidebar .logo {
        font-size: 0;
    }

    .sidebar .logo:first-letter {
        font-size: 25px;
    }

    .sidebar nav a {
        font-size: 0;
    }

    .sidebar nav a::first-letter {
        font-size: 20px;
    }

    .sidebar h3 {
        display: none;
    }

    .main-content {
        margin-left: 65px;
        padding: 15px;
    }

    header h1 {
        font-size: 21px;
    }

    .music-container {
        grid-template-columns: repeat(2, 1fr);
    }

    .featured h1 {
        font-size: 25px;
    }

    .player {
        left: 65px;
        padding: 10px;
        flex-wrap: wrap;
    }

    .current-song img {
        width: 40px;
    }

    .controls audio {
        width: 150px;
    }

    .volume {
        display: none;
    }
}
