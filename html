
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Music Vibe - Music Streaming</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Sidebar -->
    <aside class="sidebar">
        <h2 class="logo">♫ Music Vibe</h2>

        <nav>
            <a href="#" class="active">🏠 Home</a>
            <a href="#">🔍 Search</a>
            <a href="#">🎵 Your Library</a>
            <a href="#">❤️ Favorites</a>
        </nav>

        <h3>Your Playlists</h3>
        <nav>
            <a href="#">Chill Vibes</a>
            <a href="#">Romantic Songs</a>
            <a href="#">Party Mix</a>
            <a href="#">Trending Hits</a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">

        <header>
            <div>
                <h1>Good Music, Good Mood 🎧</h1>
                <p>Discover your favorite music here.</p>
            </div>

            <div class="profile">👤 User</div>
        </header>

        <!-- Featured Section -->
        <section>
            <h2>Featured Playlist</h2>

            <div class="featured">
                <div>
                    <h1>Feel The Music</h1>
                    <p>Listen to the best music collection.</p>
                    <button>Explore Now</button>
                </div>
            </div>
        </section>

        <!-- Popular Artists -->
        <section>
            <h2>Popular Artists</h2>

            <div class="artist-container">

                <div class="artist">
                    <img src="https://placehold.co/150x150/333/fff?text=Artist+1">
                    <h3>Arijit Singh</h3>
                </div>

                <div class="artist">
                    <img src="https://placehold.co/150x150/333/fff?text=Artist+2">
                    <h3>Shreya Ghoshal</h3>
                </div>

                <div class="artist">
                    <img src="https://placehold.co/150x150/333/fff?text=Artist+3">
                    <h3>Justin Bieber</h3>
                </div>

                <div class="artist">
                    <img src="https://placehold.co/150x150/333/fff?text=Artist+4">
                    <h3>Taylor Swift</h3>
                </div>

            </div>
        </section>

        <!-- Albums -->
        <section>
            <h2>Popular Albums</h2>

            <div class="music-container">

                <div class="music-card">
                    <img src="https://placehold.co/200x200/542b68/fff?text=Album+1">
                    <h3>Romantic Hits</h3>
                    <p>Arijit Singh</p>
                    <button>▶ Play</button>
                </div>

                <div class="music-card">
                    <img src="https://placehold.co/200x200/285078/fff?text=Album+2">
                    <h3>Midnight Dreams</h3>
                    <p>Taylor Swift</p>
                    <button>▶ Play</button>
                </div>

                <div class="music-card">
                    <img src="https://placehold.co/200x200/75432b/fff?text=Album+3">
                    <h3>Party Vibes</h3>
                    <p>Justin Bieber</p>
                    <button>▶ Play</button>
                </div>

                <div class="music-card">
                    <img src="https://placehold.co/200x200/315c46/fff?text=Album+4">
                    <h3>Melody Collection</h3>
                    <p>Shreya Ghoshal</p>
                    <button>▶ Play</button>
                </div>

            </div>
        </section>

        <!-- Recently Played -->
        <section>
            <h2>Recently Played</h2>

            <div class="song-list">
                <div class="song">
                    <img src="https://placehold.co/55x55/542b68/fff?text=1">
                    <div>
                        <h4>Kesariya</h4>
                        <p>Arijit Singh</p>
                    </div>
                    <span>3:45</span>
                </div>

                <div class="song">
                    <img src="https://placehold.co/55x55/285078/fff?text=2">
                    <div>
                        <h4>Perfect</h4>
                        <p>Ed Sheeran</p>
                    </div>
                    <span>4:20</span>
                </div>

                <div class="song">
                    <img src="https://placehold.co/55x55/75432b/fff?text=3">
                    <div>
                        <h4>Love Story</h4>
                        <p>Taylor Swift</p>
                    </div>
                    <span>3:55</span>
                </div>
            </div>
        </section>

        <!-- Music Player -->
        <section class="player">
            <div class="current-song">
                <img src="https://placehold.co/60x60/542b68/fff?text=Music">
                <div>
                    <h4>Kesariya</h4>
                    <p>Arijit Singh</p>
                </div>
            </div>

            <div class="controls">
                <div class="buttons">
                    <button>⏮</button>
                    <button class="play-button">▶</button>
                    <button>⏭</button>
                </div>

                <audio controls>
                    <source src="music.mp3" type="audio/mpeg">
                    Your browser does not support audio.
                </audio>
            </div>

            <div class="volume">🔊 Volume</div>
        </section>

    </main>

</body>
</html>
